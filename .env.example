# ---------------------------------------------------------------------------
# Makhana Lead Engine — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Postgres -------------------------------------------------------------
# These three are consumed by the `postgres` container in docker-compose.yml.
POSTGRES_USER=lead
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=lead_engine
POSTGRES_PORT=5432

# Connection string for HOST-SIDE tooling only: the Prisma CLI (`pnpm
# db:migrate`, `db:seed`, `db:studio`) and any service you run with `pnpm dev`
# outside Docker. Keep the password in sync with POSTGRES_PASSWORD above.
#
# Containers do NOT read this. docker-compose.yml builds their connection
# string from the POSTGRES_* vars with host `postgres`, so you never have to
# maintain two spellings of the same credential.
DATABASE_URL="postgresql://lead:change-me-in-production@localhost:5432/lead_engine?schema=public"

# The test suite TRUNCATEs every table, so it must never run against the
# database above. If unset, the suite derives a "<name>_test" sibling of
# DATABASE_URL. Create it once with:
#   createdb -O lead lead_engine_test && pnpm db:migrate
# resetDatabase() refuses to run unless the database name contains "test".
TEST_DATABASE_URL=

# --- Redis (BullMQ job queue) ---------------------------------------------
REDIS_PORT=6379
# Host-side only, same as DATABASE_URL above. Containers use redis://redis:6379.
REDIS_URL=redis://localhost:6379

# --- Service ports / URLs -------------------------------------------------
API_PORT=4000
WEB_PORT=5173
DOCGEN_PORT=4100
OUTREACH_PORT=4200

# How services address each other when you run them OUTSIDE Docker (pnpm dev).
# Containers do NOT read these: docker-compose.yml builds them from the service
# names, exactly as it does for DATABASE_URL — the correct value differs by side
# of the container boundary, so only one side has to be right here.
API_URL=http://localhost:4000
DOCGEN_URL=http://localhost:4100
OUTREACH_URL=http://localhost:4200

# --- Public origin (production) -------------------------------------------
# The URL users actually reach the app on. In production this is your domain;
# for an IP-only deployment use http://<vm-ip>.
#
# This drives the session cookie's Secure flag. A Secure cookie is silently
# discarded by the browser over plain HTTP, which presents as "login works but
# every other request returns 401" — so PUBLIC_URL's scheme must match how the
# site is actually served.
PUBLIC_URL=http://localhost:5173

# Caddy's site address. A bare domain turns on automatic HTTPS; ':80' serves
# plain HTTP for an IP-only deployment. Keep this in step with PUBLIC_URL.
#   CADDY_SITE_ADDRESS=leads.example.com   -> https, certificate issued for you
#   CADDY_SITE_ADDRESS=:80                 -> http only
CADDY_SITE_ADDRESS=:80

# Browser-facing API origin (baked into the web build by Vite).
# Leave as /api in production: nginx and Caddy put the API on the same origin
# as the app, which is what keeps the session cookie first-party.
VITE_API_URL=http://localhost:4000

# Comma-separated origins allowed to call the API with credentials. Leave empty
# to default to PUBLIC_URL, which is correct behind the bundled reverse proxy
# (the browser only ever sees one origin). Credentialed CORS forbids '*'.
CORS_ORIGINS=

# --- Auth -----------------------------------------------------------------
# Sign/encrypt session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32-value
SESSION_TTL_HOURS=720

# Seeded on first `pnpm db:seed`. Change the password after first login.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-before-seeding

# Shared secret for service-to-service calls (scraper -> api, api -> docgen).
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=replace-with-openssl-rand-hex-32-value

# --- Scraper --------------------------------------------------------------
# !! The scraper MUST run from an Indian IP. IndiaMART redirects non-Indian
# !! IPs to a host that 403s. See services/scraper/README.md.
SCRAPER_MAX_REQUESTS_PER_RUN=300
SCRAPER_MIN_DELAY_MS=3500
SCRAPER_MAX_DELAY_MS=9000
SCRAPER_BATCH_SIZE=40
SCRAPER_BATCH_PAUSE_MS=90000
SCRAPER_HEADLESS=true

# Point at an existing Chromium instead of Puppeteer's bundled download. Leave
# blank to use the bundled one. PUPPETEER_EXECUTABLE_PATH also works.
SCRAPER_CHROME_PATH=
SCRAPER_NAV_TIMEOUT_MS=45000

# Abort a run immediately if we detect we are not on an Indian IP / are being
# geo-walled, rather than silently returning zero leads.
SCRAPER_GEO_CHECK_ENABLED=true

# Recurring scrape schedule. Disabled by default — trigger runs from the CRM
# or the CLI until you trust the output, then flip this on.
SCRAPER_SCHEDULE_ENABLED=false
SCRAPER_SCHEDULE_CRON="0 3 1 * *"

# --- Google Places (OPTIONAL, opt-in, costs money) ------------------------
# Leave the key blank to keep this source disabled. Nothing else in the system
# requires it.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=

# --- Docgen ---------------------------------------------------------------
# Where generated .docx / .pptx artifacts are written.
STORAGE_DIR=/data/storage

# --- Outreach -------------------------------------------------------------
# One of: resend | smtp | log
# `log` writes the message to stdout + the interaction timeline and sends
# nothing — safe default until your sending domain is verified.
OUTREACH_PROVIDER=log
OUTREACH_FROM_EMAIL=sales@example.com
OUTREACH_FROM_NAME="Your Brand Name"
OUTREACH_REPLY_TO=

# Resend (https://resend.com) — required when OUTREACH_PROVIDER=resend
RESEND_API_KEY=

# SMTP — required when OUTREACH_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# WhatsApp Business API requires Meta business verification and an approved
# message template. Not implemented — see services/outreach/README.md.
WHATSAPP_ENABLED=false

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // DOM is needed even though this is a Node process: the functions passed
    // to page.evaluate() are serialised and executed inside the browser, so
    // they legitimately reference document, window and Element.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
